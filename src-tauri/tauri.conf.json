{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "diary",
  "version": "0.1.4",
  "identifier": "com.khurram.diary",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Diary",
        "width": 720,
        "height": 1000,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "minWidth": 720,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnRzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFRTQwMTdFNTg3RTM2NTAKUldSUU5uNVlmZ0hrenFCaWJteVBGaEgySjBtaVJNdVFXNmQwdk9obXIzMXI2THI5MExkTHA3U0wK",
      "endpoints": [
        "https://github.com/khurrambhutto/diary/releases/latest/download/update.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
